# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=pmc_rag
MONGODB_COLLECTION=article_chunks
MONGODB_INDEX_NAME=vector_index

# Embeddings (biomedical sentence-transformers model)
EMBEDDING_MODEL_NAME=NeuML/pubmedbert-base-embeddings

# Groq (free tier, no credit card required) - get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b

# Retrieval
TOP_K=5

# Ingestion defaults
# Kept under ~1000 to stay within MongoDB Atlas M0 free tier's 512 MB storage cap
# (~0.47 MB/article observed; ~800 articles leaves headroom for the vector index)
PMC_TOPIC_QUERY=Neurology and Psychiatry
PMC_MAX_ARTICLES=800
NCBI_API_EMAIL=you@example.com
